{
  "name": "vlab-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx prisma/reset-demo.ts",
    "test": "vitest run",
    "spike": "tsx scripts/spike.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "dockerode": "5.0.1",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.2",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.43",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
