# --- backend ---
PORT=3000
DATABASE_URL=file:/app/data/vlab.db
UPLOADS_DIR=/app/data/uploads
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- docker ---
DOCKER_SOCKET=/var/run/docker.sock
VLAB_IMAGE_LINUX_BASIC=vlab/linux-basic:latest
VLAB_IMAGE_DOCKER_DIND=vlab/docker-dind:latest
DIND_MEMORY_MB=1024
BASIC_MEMORY_MB=512
CHECKER_INTERVAL_SECONDS=30
CHECK_TIMEOUT_SECONDS=15
SESSION_IDLE_MINUTES=30

# --- registry pull-through cache ---
REGISTRY_MIRROR=http://host.docker.internal:5001

# --- frontend (dev only; nginx proxies in compose) ---
VITE_API_BASE=/api
